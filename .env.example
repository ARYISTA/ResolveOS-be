# Database credentials for local development
# NEVER commit this file. Commit only .env.example.
POSTGRES_USER=resolvos_owner
POSTGRES_PASSWORD=change_me_local

# Application role (no BYPASSRLS, owns nothing)
APP_DB_USER=resolvos_app
APP_DB_PASSWORD=change_me_app_local

# JWT secret — must be at least 32 bytes (256 bits)
JWT_SECRET=dev-secret-32-bytes-minimum-here!

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000
